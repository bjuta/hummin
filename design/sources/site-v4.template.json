flex;justify-content:space-between;gap:12px;flex-wrap:wrap\"><span style=\"display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 14px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:0.04em;background:rgba(244,245,241,0.08);border:1px solid rgba(244,245,241,0.16);color:#F4F5F1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\"><span style=\"display:block;width:14px;height:14px;background:url({{ head.iconPaper }}) center/contain no-repeat\"></span>{{ head.label }}</span><span style=\"display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 14px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:0.04em;background:rgba(244,245,241,0.08);border:1px solid rgba(244,245,241,0.16);color:#F4F5F1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\">{{ head.chip }}</span></div>\n        <div style=\"position:relative;pointer-events:none;width:100%;margin:0 auto;padding:0 clamp(20px,5cqw,64px) clamp(32px,5cqw,64px);display:grid;gap:24px\">\n          <h1 data-rise=\"1\" style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(48px,7.6cqw,116px);line-height:0.92;letter-spacing:-0.03em;max-width:13ch\">{{ head.title }}</h1>\n          <p data-rise=\"1\" style=\"margin:0;font-size:clamp(17px,1.6cqw,20px);line-height:1.55;color:#E7EBE6;max-width:50ch\">{{ head.lead }}</p>\n        </div>\n      </section>\n    </sc-if>\n\n    <!-- ===== HOW ===== -->\n    <sc-if value=\"{{ is_how }}\" hint-placeholder-val=\"{{ false }}\">\n      <section data-rise=\"1\" style=\"display:grid;gap:24px;padding-bottom:clamp(80px,10cqw,128px)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\"><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">Four steps, in order.</h2><div style=\"display:flex;gap:8px\"><button type=\"button\" sc-camel-on-clic