nsform:translateY(16px)}to{opacity:1;transform:none}}\n@keyframes hmPop{0%{transform:scale(0.6);opacity:0}70%{transform:scale(1.08);opacity:1}100%{transform:scale(1)}}\n@keyframes hmSpin{to{transform:rotate(360deg)}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}\n</style>\n</helmet>\n\n<div ref=\"{{ root }}\" style=\"container-type:inline-size;background:#F4F5F1;color:#1E272A;font-family:'Figtree',system-ui,sans-serif;min-height:100%\">\n  <a href=\"#main\" sc-camel-on-click=\"{{ skipToMain }}\" style=\"position:absolute;left:-9999px;top:12px;z-index:60;padding:12px 18px;border-radius:999px;background:#1E272A;color:#F4F5F1;font-weight:600;font-size:14px\" style-focus=\"left:16px\">Skip to content</a>\n\n  <!-- TOP BAR + DRAWER -->\n  <header style=\"position:sticky;top:0;z-index:20\">\n    <div style=\"background:rgba(244,245,241,0.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid #D0D8D2;box-shadow:{{ headShadow }};transition:box-shadow 240ms cubic-bezier(0.2,0,0,1)\">\n      <div style=\"margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px clamp(20px,5cqw,64px)\">\n        <div style=\"display:flex;align-items:center;gap:16px\">\n          <button type=\"button\" sc-camel-on-click=\"{{ toggleMenu }}\" sc-camel-on-mouse-enter=\"{{ hoverOpen }}\" sc-camel-on-mouse-leave=\"{{ hoverLeave }}\" aria-label=\"{{ menuAria }}\" aria-expanded=\"{{ menuOpenStr }}\" aria-controls=\"site-nav\" style-active=\"transform:scale(0.94)\" style=\"width:44px;height:44px;border-radius:999px;border:1px solid #D0D8D2;background:transparent;cursor:pointer;display:grid;place-items:center;padding:0;transition:background 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#E7EBE6\"><span aria-hidden=\"true\" style=\"position:relative;display:block;width:20px;height:20px\"><img src=\"a1cd93fd-ea2c-4207-8c0b-95b4c0c3d70e\" alt=\"\" style=\"position:absolute;inset:0;width:20px;height:20px;opacity:{{ icoMenuOp }};transform:{{ icoMenuTf }};transition:opacity 200ms cubic-bezier(0.2,0,0,1),transform 240ms cubic-bezier(0.2,0,0,1)\"><img src=\"0c33de8d-2a16-4b33-b5ee-0cbafb96d1ee\" alt=\"\" style=\"position:absolute;inset:0;width:20px;height:20px;opacity:{{ icoXOp }};transform:{{ icoXTf }};transition:opacity 200ms cubic-bezier(0.2,0,0,1),transform 240ms cubic-bezier(0.2,0,0,1)\"></span></button>\n          <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-label=\"HUMMIN, go to home page\" sc-camel-on-click=\"{{ go_home }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:flex;align-items:center;gap:10px;cursor:pointer\"><img src=\"69600b5c-99d3-4ec0-9520-3db39d09fc81\" alt=\"\" style=\"width:42px\"><span style=\"font-weight:600;letter-spacing:0.18em;font-size:15px\">HUMMIN</span></button>\n        </div>\n        <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_contact }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;background:#1E272A;color:#F4F5F1;font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap;transition:background 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#B5532C\">Get in Touch</button>\n      </div>\n    </div>\n    <div sc-camel-on-click=\"{{ closeMenu }}\" aria-hidden=\"true\" style=\"position:absolute;top:100%;left:0;right:0;height:100vh;background:rgba(30,39,42,0.32);opacity:{{ scrimOpacity }};pointer-events:{{ scrimEvents }};transition:opacity 240ms cubic-bezier(0.2,0,0,1)\"></div>\n    <nav id=\"site-nav\" aria-label=\"Main\" sc-camel-on-mouse-enter=\"{{ hoverOpen }}\" sc-camel-on-mouse-leave=\"{{ hoverLeave }}\" style=\"position:absolute;top:100%;left:0;width:min(340px,100%);height:calc(100vh - 69px);overflow-y:auto;background:#F4F5F1;border-right:1px solid #D0D8D2;padding:24px 20px 32px;display:grid;align-content:start;gap:28px;transform:{{ drawerX }};visibility:{{ drawerVis }};transition:transform 240ms cubic-bezier(0.2,0,0,1),visibility 240ms\">\n      <div style=\"display:grid;gap:2px\">\n        <sc-for list=\"{{ nav }}\" as=\"n\" hint-placeholder-count=\"8\">\n          <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-current=\"{{ n.current }}\" sc-camel-on-click=\"{{ n.onClick }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;width:100%;cursor:pointer;display:flex;align-items:center;gap:14px;min-height:48px;padding:0 12px;border-radius:6px;background:{{ n.bg }};transition:background 120ms cubic-bezier(0.2,0,0,1),padding 200ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#E7EBE6;padding-left:18px\">\n            <span style=\"display:block;width:20px;height:20px;flex-shrink:0;background:url({{ n.icon }}) center/contain no-repeat;opacity:{{ n.op }}\"></span>\n            <span style=\"font-size:16px;font-weight:{{ n.weight }};color:{{ n.color }}\">{{ n.label }}</span>\n          </button>\n        </sc-for>\n      </div>\n      <div style=\"display:grid;gap:14px;border-top:1px solid #D0D8D2;padding:24px 12px 0\">\n        <a href=\"mailto:sales@hummin.org\" style=\"display:flex;align-items:center;gap:12px;color:#1E272A;font-size:15px\"><img src=\"34508a24-b2f6-475b-9efe-357ea43a219f\" alt=\"\" style=\"width:18px;height:18px\">sales@hummin.org</a>\n        <span style=\"display:flex;align-items:center;gap:12px;font-size:15px;color:#434F4F\"><img src=\"f46ed469-83d7-4d18-9b79-350a047b9f00\" alt=\"\" style=\"width:18px;height:18px;opacity:0.7\">Nairobi, Kenya</span>\n      </div>\n    </nav>\n  </header>\n\n  <div ref=\"{{ pageRef }}\" style=\"transition:opacity 200ms cubic-bezier(0.2,0,0,1),transform 200ms cubic-bezier(0.2,0,0,1)\">\n  <main id=\"main\" sc-camel-tab-index=\"-1\" style=\"outline:none;margin:0 auto;padding:clamp(48px,7cqw,104px) clamp(20px,5cqw,64px) 0\">\n\n    <!-- ===== HOME ===== -->\n    <sc-if value=\"{{ is_home }}\" hint-placeholder-val=\"{{ true }}\">\n      <section data-hero=\"1\" style=\"position:relative;overflow:hidden;margin:calc(-1 * clamp(48px,7cqw,104px)) calc(-1 * clamp(20px,5cqw,64px)) clamp(80px,10cqw,144px);min-height:clamp(620px,62cqw,860px);background:radial-gradient(circle at 72% 28%,#5E6967 0%,#2A3538 38%,#1E272A 70%);color:#F4F5F1;display:grid;align-content:end\">\n        <div style=\"position:absolute;inset:0\"><image-slot id=\"hero-home\" shape=\"rect\" empty-pos=\"top-right\" placeholder=\"01 · Home hero: owners and teams at work, in their own premises\" src=\"91c0a428-8661-4dcf-b019-808b39798607\"></image-slot></div>\n        <div style=\"position:absolute;inset:0;background:linear-gradient(180deg,rgba(30,39,42,0.55) 0%,rgba(30,39,42,0) 22%,rgba(30,39,42,0) 40%,rgba(30,39,42,0.88) 100%);pointer-events:none\"></div>\n        <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,39,42,0.9) 0%,rgba(30,39,42,0.72) 28%,rgba(30,39,42,0.34) 58%,rgba(30,39,42,0.08) 82%,rgba(30,39,42,0) 100%);pointer-events:none\"></div>\n        <img src=\"08f1bf1c-2007-4b2a-88c7-a228a21caea3\" alt=\"\" aria-hidden=\"true\" style=\"position:absolute;width:max(560px,58cqw);left:-14cqw;bottom:-18%;opacity:0.22;mix-blend-mode:screen;pointer-events:none;-webkit-mask-image:linear-gradient(90deg,#000 0%,#000 40%,transparent 85%);mask-image:linear-gradient(90deg,#000 0%,#000 40%,transparent 85%)\">\n        <div style=\"position:absolute;inset:0;background:radial-gradient(circle at 18% 92%,rgba(30,39,42,0.6),transparent 48%);pointer-events:none\"></div>\n        <div style=\"position:absolute;pointer-events:none;top:clamp(20px,3cqw,32px);left:clamp(20px,5cqw,64px);right:clamp(20px,5cqw,64px);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap\"><span style=\"display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 14px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:0.04em;background:rgba(244,245,241,0.08);border:1px solid rgba(244,245,241,0.16);color:#F4F5F1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\">Embedded advisory and execution</span><span style=\"display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 14px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:0.04em;background:rgba(244,245,241,0.08);border:1px solid rgba(244,245,241,0.16);color:#F4F5F1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\">Nairobi, Kenya</span></div>\n        <div style=\"position:relative;pointer-events:none;width:100%;margin:0 auto;padding:0 clamp(20px,5cqw,64px) clamp(32px,5cqw,64px);display:grid;gap:28px\">\n          <h1 data-rise=\"1\" style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(54px,10cqw,152px);line-height:0.9;letter-spacing:-0.035em\">Inside your business.<br><em style=\"color:#BAC4BE\">Behind your progress.</em></h1>\n          <div data-rise=\"1\" style=\"display:flex;flex-wrap:wrap;gap:20px 48px;align-items:end;justify-content:space-between\">\n            <p style=\"margin:0;font-size:clamp(17px,1.6cqw,20px);line-height:1.55;color:#E7EBE6;max-width:44ch;flex:1 1 300px\">We work with established, owner-led businesses to understand what is holding them back and put practical changes to work.</p>\n            <div style=\"display:flex;gap:10px;flex-wrap:wrap;pointer-events:auto\">\n              <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_contact }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 24px;border-radius:999px;background:#F4F5F1;color:#1E272A;font-weight:700;font-size:15px;cursor:pointer;transition:transform 240ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:translateY(-2px)\">Discuss a Business Challenge <span aria-hidden=\"true\">→</span></button>\n              <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_assess }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:inline-flex;align-items:center;min-height:52px;padding:0 22px;border-radius:999px;border:1.5px solid rgba(244,245,241,0.4);color:#F4F5F1;font-weight:600;font-size:15px;cursor:pointer;transition:border-color 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"border-color:#F4F5F1\">Take the Assessment</button>\n            </div>\n          </div>\n          </div>\n      </section>\n\n      <section data-rise=\"1\" style=\"display:flex;flex-wrap:wrap;gap:32px clamp(40px,6cqw,96px);padding-bottom:clamp(80px,10cqw,144px)\">\n        <p style=\"margin:0;flex:3 1 480px;font-family:'Newsreader',serif;font-size:clamp(32px,4.2cqw,58px);line-height:1.08;letter-spacing:-0.015em\">Good businesses encounter problems that do not fit neatly into departments.</p>\n        <div style=\"flex:2 1 300px;display:grid;gap:18px;align-content:end\">\n          <p style=\"margin:0;font-size:17px;line-height:1.65;color:#434F4F\">A slow month of enquiries can look like a marketing problem. The cause may sit in how enquiries are answered, the tools the team uses, or who owns the follow-up.</p>\n          <p style=\"margin:0;font-size:17px;line-height:1.65;color:#434F4F\">We find the cause, bring in the people needed to fix it, and stay involved until the work is done.</p>\n        </div>\n      </section>\n\n      <section data-rise=\"1\" style=\"padding-bottom:clamp(80px,10cqw,144px);display:grid;gap:24px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\">\n          <div style=\"display:grid;gap:12px\"><span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#B5532C\">Where we often start</span><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">Problems owners bring to us.</h2></div>\n          <div style=\"display:flex;gap:8px\"><button type=\"button\" sc-camel-on-click=\"{{ shelfPrev }}\" style-active=\"transform:scale(0.92)\" aria-label=\"Scroll back\" style=\"width:48px;height:48px;border-radius:999px;border:1px solid #1E272A;background:transparent;cursor:pointer;display:grid;place-items:center\" style-hover=\"background:#E7EBE6\"><img src=\"df4e8ee2-a320-47a6-90d8-d6e3eb5716ac\" alt=\"\" aria-hidden=\"true\" style=\"width:18px\"></button><button type=\"button\" sc-camel-on-click=\"{{ shelfNext }}\" style-active=\"transform:scale(0.92)\" aria-label=\"Scroll forward\" style=\"width:48px;height:48px;border-radius:999px;border:none;background:#1E272A;cursor:pointer;display:grid;place-items:center\" style-hover=\"background:#B5532C\"><img src=\"cdda5423-6a0a-4897-8150-8b83c9da8fcc\" alt=\"\" aria-hidden=\"true\" style=\"width:18px\"></button></div>\n        </div>\n        <div data-shelf=\"1\" role=\"region\" aria-label=\"Problems owners bring to us\" style=\"display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 calc(-1 * clamp(20px,5cqw,64px));padding:8px clamp(20px,5cqw,64px) 20px;scroll-padding:0 clamp(20px,5cqw,64px)\">\n          <sc-for list=\"{{ topics }}\" as=\"p\" hint-placeholder-count=\"4\">\n            <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-haspopup=\"dialog\" aria-label=\"{{ p.aria }}\" sc-camel-on-click=\"{{ p.onClick }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;flex:0 0 min(300px,78%);scroll-snap-align:start;position:relative;overflow:hidden;border-radius:20px;aspect-ratio:4/5;background:{{ p.bg }};color:{{ p.fg }};display:grid;align-content:space-between;padding:20px;text-align:left;transition:transform 240ms cubic-bezier(0.2,0,0,1),box-shadow 240ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:translateY(-6px);box-shadow:0 18px 36px rgba(30,39,42,0.18)\">\n              <span style=\"position:absolute;inset:0;background:url({{ p.mark }}) right -40% bottom -30%/130% auto no-repeat;pointer-events:none\"></span>\n              <span style=\"position:relative;justify-self:start;display:inline-flex;align-items:center;min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:600;background:{{ p.chipBg }};border:1px solid {{ p.chipBd }};backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\">{{ p.area }}</span>\n              <span style=\"position:relative;display:grid;gap:14px\"><span style=\"font-family:'Newsreader',serif;font-size:clamp(26px,2.6cqw,32px);line-height:1.08;letter-spacing:-0.01em\">{{ p.title }}</span><span style=\"display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;opacity:0.8\">Read more <span aria-hidden=\"true\" style=\"display:grid;place-items:center;width:22px;height:22px;border-radius:999px;border:1px solid currentColor;font-size:14px;line-height:1\">+</span></span></span>\n            </button>\n          </sc-for>\n        </div>\n      </section>\n\n      <section style=\"padding-bottom:clamp(80px,10cqw,144px);display:grid;gap:28px\">\n        <span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#B5532C\">Ways to work with us</span>\n        <p style=\"margin:0;font-family:'Newsreader',serif;font-size:clamp(34px,4.8cqw,68px);line-height:1.12;letter-spacing:-0.02em;max-width:22ch\">Start with a <button type=\"button\" sc-camel-on-click=\"{{ peekTier0 }}\" aria-haspopup=\"dialog\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;border-bottom:2px solid #B5532C;transition:color 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"color:#B5532C\">Review</button>. Fix it with a <button type=\"button\" sc-camel-on-click=\"{{ peekTier1 }}\" aria-haspopup=\"dialog\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;border-bottom:2px solid #B5532C;transition:color 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"color:#B5532C\">Project</button>. Keep us close with a <button type=\"button\" sc-camel-on-click=\"{{ peekTier2 }}\" aria-haspopup=\"dialog\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;border-bottom:2px solid #B5532C;transition:color 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"color:#B5532C\">Residency</button>.</p>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:14px;margin-top:12px\">\n          <sc-for list=\"{{ posters }}\" as=\"e\" hint-placeholder-count=\"3\">\n            <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-haspopup=\"dialog\" aria-label=\"{{ e.aria }}\" sc-camel-on-click=\"{{ e.peek }}\" data-rise=\"1\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;position:relative;overflow:hidden;border-radius:20px;min-height:400px;background:{{ e.bg }};color:{{ e.fg }};padding:24px;display:grid;align-content:space-between;gap:24px;text-align:left;transition:transform 240ms cubic-bezier(0.2,0,0,1),box-shadow 240ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:translateY(-6px);box-shadow:0 18px 36px rgba(30,39,42,0.18)\">\n              <span style=\"position:absolute;inset:0;background:{{ e.glow }};pointer-events:none\"></span>\n              <span style=\"position:relative;justify-self:start;display:inline-flex;align-items:center;min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:600;background:{{ e.chipBg }};border:1px solid {{ e.chipBd }}\">{{ e.tag }}</span>\n              <div style=\"position:relative;display:grid;gap:12px\"><span style=\"font-family:'Newsreader',serif;font-size:clamp(52px,6cqw,80px);line-height:0.9;letter-spacing:-0.03em\">{{ e.name }}</span><span style=\"font-size:16px;line-height:1.5;opacity:0.86\">{{ e.body }}</span><span style=\"display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;opacity:0.8;margin-top:6px\">Read more <span aria-hidden=\"true\" style=\"display:grid;place-items:center;width:22px;height:22px;border-radius:999px;border:1px solid currentColor;font-size:14px;line-height:1\">+</span></span></div>\n            </button>\n          </sc-for>\n        </div>\n      </section>\n\n      <section style=\"padding-bottom:clamp(80px,10cqw,144px);display:grid;gap:40px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\">\n          <h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">How a piece of work runs.</h2>\n          <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_how }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;font-weight:600;font-size:15px;color:#B5532C;cursor:pointer;border-bottom:1px solid #B5532C;padding-bottom:2px\" style-hover=\"color:#1E272A;border-bottom-color:#1E272A\">See How We Work</button>\n        </div>\n        <div style=\"position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:32px 24px\">\n          <sc-for list=\"{{ stages }}\" as=\"s\" hint-placeholder-count=\"4\">\n            <div data-rise=\"1\" style=\"display:grid;gap:12px;align-content:start;border-top:2px solid #1E272A;padding-top:18px\">\n              <span style=\"font-weight:600;font-size:18px\">{{ s.name }}</span>\n              <span style=\"font-size:15px;line-height:1.55;color:#434F4F\">{{ s.short }}</span>\n            </div>\n          </sc-for>\n        </div>\n      </section>\n\n      <section style=\"padding-bottom:clamp(80px,10cqw,144px);display:grid;gap:32px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\">\n          <div style=\"display:grid;gap:10px\"><span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#B5532C\">Insights</span><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">Practical notes for owners.</h2></div>\n          <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ allInsights }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;font-weight:600;font-size:15px;color:#B5532C;cursor:pointer;border-bottom:1px solid #B5532C;padding-bottom:2px\" style-hover=\"color:#1E272A;border-bottom-color:#1E272A\">All Insights</button>\n        </div>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px\">\n          <sc-for list=\"{{ insightTeasers }}\" as=\"it\" hint-placeholder-count=\"3\">\n            <button type=\"button\" data-rise=\"1\" sc-camel-on-click=\"{{ it.open }}\" aria-label=\"{{ it.aria }}\" style-active=\"transform:scale(0.98)\" style=\"display:grid;align-content:space-between;gap:24px;min-height:300px;padding:24px;border-radius:20px;border:1px solid {{ it.bd }};background:{{ it.bg }};color:{{ it.fg }};font:inherit;text-align:left;cursor:pointer;transition:transform 240ms cubic-bezier(0.2,0,0,1),box-shadow 240ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:translateY(-6px);box-shadow:0 18px 36px rgba(30,39,42,0.16)\">\n              <div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"display:inline-flex;align-items:center;min-height:28px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:700;background:{{ it.chipBg }};border:1px solid {{ it.chipBd }}\">{{ it.type }}</span><span style=\"font-size:12px;font-weight:600;opacity:0.7\">{{ it.read }}</span></div>\n              <div style=\"display:grid;gap:10px\"><span style=\"font-family:'Newsreader',serif;font-size:clamp(26px,2.6cqw,32px);line-height:1.06\">{{ it.title }}</span><span style=\"font-size:15px;line-height:1.55;opacity:0.82\">{{ it.excerpt }}</span></div>\n              <span style=\"font-size:13px;font-weight:600;opacity:0.8\">{{ it.by }}</span>\n            </button>\n          </sc-for>\n        </div>\n      </section>\n    </sc-if>\n\n    <!-- ===== INNER HEADER ===== -->\n    <sc-if value=\"{{ inner }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"position:relative;overflow:hidden;margin:calc(-1 * clamp(48px,7cqw,104px)) calc(-1 * clamp(20px,5cqw,64px)) clamp(64px,8cqw,112px);min-height:clamp(480px,46cqw,640px);background:{{ head.bg }};color:#F4F5F1;display:grid;align-content:end\">\n        <sc-if value=\"{{ is_how }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"position:absolute;inset:0\"><image-slot id=\"hero-how\" shape=\"rect\" empty-pos=\"top-right\" placeholder=\"02 · How We Work hero: reviewing a process with the people who run it\" src=\"681cedc5-813e-490a-a623-c6e0f126ef26\"></image-slot></div></sc-if>\n        <sc-if value=\"{{ is_core }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"position:absolute;inset:0\"><image-slot id=\"hero-core\" shape=\"rect\" empty-pos=\"top-right\" placeholder=\"03 · Applied Expertise hero: a working session with specialists\" src=\"d8a9ab9f-bb47-43e2-b6ba-997b43544a7c\"></image-slot></div></sc-if>\n        <sc-if value=\"{{ is_eng }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"position:absolute;inset:0\"><image-slot id=\"hero-eng\" shape=\"rect\" empty-pos=\"top-right\" placeholder=\"04 · Engagements hero: a HUMMIN professional on site\" src=\"228293ea-a0f4-4d1a-9bb7-1fe7