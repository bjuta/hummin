lic;font-size:clamp(44px,5cqw,64px);line-height:0.95;letter-spacing:-0.02em\">{{ s.name }}</span>\n                <span style=\"font-size:17px;line-height:1.55\">{{ s.what }}</span>\n                <span style=\"font-size:15px;line-height:1.5;opacity:0.8;border-top:1px solid {{ s.chipBd }};padding-top:14px\">You receive: {{ s.out }}</span>\n              </div>\n            </div>\n          </sc-for>\n        </div>\n      </section>\n      <section style=\"position:relative;overflow:hidden;margin:0 calc(-1 * clamp(20px,5cqw,64px));background:#1E272A;color:#F4F5F1;padding:clamp(64px,8cqw,112px) clamp(20px,5cqw,64px)\">\n        <div style=\"position:absolute;inset:0;background:radial-gradient(circle at 92% 0%,rgba(181,83,44,0.32),transparent 45%),radial-gradient(circle at 0% 100%,rgba(46,107,92,0.25),transparent 40%);pointer-events:none\"></div>\n        <div style=\"position:relative;display:grid;gap:clamp(40px,5cqw,64px)\">\n          <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px 40px\">\n            <div style=\"display:grid;gap:14px\"><span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#E58A5F\">What we need from you</span><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,4.4cqw,60px);line-height:1.02;letter-spacing:-0.02em;max-width:16ch\">Four things we ask of every client.</h2></div>\n            <p style=\"margin:0;font-size:16px;line-height:1.6;color:#BAC4BE;max-width:38ch\">We agree these with you at the start of every engagement.</p>\n          </div>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))\">\n            <sc-for list=\"{{ needs }}\" as=\"n\" hint-placeholder-count=\"4\">\n              <div data-rise=\"1\" style=\"display:grid;gap:14px;align-content:start;padding:24px clamp(16px,2cqw,28px) 8px;border-left:1px solid rgba(244,245,241,0.16)\">\n                <span style=\"width:44px;height:44px;border-radius:999px;background:rgba(244,245,241,0.08);border:1px solid rgba(244,245,241,0.16);display:grid;place-items:center\"><span style=\"display:block;width:20px;height:20px;background:url({{ n.icon }}) center/contain no-repeat\"></span></span>\n                <span style=\"font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,3.6cqw,52px);line-height:0.95;letter-spacing:-0.02em\">{{ n.v }}</span>\n                <span style=\"font-size:16px;line-height:1.55;color:#D0D8D2\">{{ n.k }}</span>\n              </div>\n            </sc-for>\n          </div>\n        </div>\n      </section>\n    </sc-if>\n\n    <!-- ===== CORE ===== -->\n    <sc-if value=\"{{ is_core }}\" hint-placeholder-val=\"{{ false }}\">\n      <section data-rise=\"1\" style=\"display:grid;gap:24px;padding-bottom:clamp(48px,6cqw,72px)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\"><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">Seven areas. Pick one.</h2><div style=\"display:flex;gap:8px\"><button type=\"button\" sc-camel-on-click=\"{{ shelfPrev }}\" style-active=\"transform:scale(0.92)\" aria-label=\"Scroll back\" style=\"width:48px;height:48px;border-radius:999px;border:1px solid #1E272A;background:transparent;cursor:pointer;display:grid;place-items:center\" style-hover=\"background:#E7EBE6\"><img src=\"df4e8ee2-a320-47a6-90d8-d6e3eb5716ac\" alt=\"\" aria-hidden=\"true\" style=\"width:18px\"></button><button type=\"button\" sc-camel-on-click=\"{{ shelfNext }}\" style-active=\"transform:scale(0.92)\" aria-label=\"Scroll forward\" style=\"width:48px;height:48px;border-radius:999px;border:none;background:#1E272A;cursor:pointer;display:grid;place-items:center\" style-hover=\"background:#B5532C\"><img src=\"cdda5423-6a0a-4897-8150-8b83c9da8fcc\" alt=\"\" aria-hidden=\"true\" style=\"width:18px\"></button></div></div>\n        <div data-shelf=\"1\" role=\"region\" aria-label=\"Seven areas of Applied Expertise\" style=\"display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 calc(-1 * clamp(20px,5cqw,64px));padding:8px clamp(20px,5cqw,64px) 16px;scroll-padding:0 clamp(20px,5cqw,64px)\">\n          <sc-for list=\"{{ domains }}\" as=\"d\" hint-placeholder-count=\"7\">\n            <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-pressed=\"{{ d.pressed }}\" aria-controls=\"core-detail\" sc-camel-on-click=\"{{ d.pick }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;flex:0 0 min(240px,70%);scroll-snap-align:start;position:relative;overflow:hidden;border-radius:20px;aspect-ratio:3/4;background:{{ d.bg }};color:{{ d.fg }};padding:20px;display:grid;align-content:space-between;box-shadow:inset 0 0 0 2px {{ d.ring }};text-align:left;transition:transform 240ms cubic-bezier(0.2,0,0,1),background 240ms cubic-bezier(0.2,0,0,1),color 240ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:translateY(-6px)\">\n              <span style=\"display:block;width:28px;height:28px;background:url({{ d.iconUrl }}) center/contain no-repeat\"></span>\n              <div style=\"display:grid;gap:6px\"><span style=\"font-family:'Newsreader',serif;font-size:clamp(28px,2.8cqw,34px);line-height:1\">{{ d.name }}</span><span style=\"font-size:12px;font-weight:600;opacity:0.7\">{{ d.kind }}</span></div>\n            </button>\n          </sc-for>\n        </div>\n      </section>\n      <section id=\"core-detail\" aria-live=\"polite\" style=\"margin:0 calc(-1 * clamp(20px,5cqw,64px)) clamp(64px,8cqw,112px);background:#1E272A;color:#F4F5F1;padding:clamp(48px,6cqw,88px) clamp(20px,5cqw,64px);position:relative;overflow:hidden\">\n        <div style=\"position:absolute;inset:0;background:radial-gradient(circle at 90% 0%,rgba(181,83,44,0.3),transparent 50%);pointer-events:none\"></div>\n        <div key=\"{{ cur.name }}\" style=\"position:relative;display:flex;flex-wrap:wrap;gap:28px clamp(40px,6cqw,96px);animation:hmFade 360ms cubic-bezier(0.2,0,0,1)\">\n          <div style=\"flex:1 1 280px;display:grid;gap:14px;align-content:start\"><span style=\"display:block;width:32px;height:32px;background:url({{ cur.iconPaper }}) center/contain no-repeat\"></span><span style=\"font-family:'Newsreader',serif;font-size:clamp(44px,5.4cqw,80px);line-height:0.92;letter-spacing:-0.025em\">{{ cur.name }}</span></div>\n          <div style=\"flex:2 1 400px;display:grid;gap:18px;align-content:end\"><p style=\"margin:0;font-family:'Newsreader',serif;font-size:clamp(24px,2.4cqw,32px);line-height:1.25\">{{ cur.lead }}</p><p style=\"margin:0;font-size:17px;line-height:1.65;color:#D0D8D2\">{{ cur.jobs }}</p></div>\n        </div>\n      </section>\n      <p style=\"margin:0 0 clamp(64px,8cqw,112px);font-size:15px;line-height:1.6;color:#434F4F;max-width:64ch\">Specialist partners are external professionals hired for a defined piece of work. We tell you who they are, what they are responsible for, and how they are paid. We do not take on work that needs qualifications or licences we do not hold.</p>\n    </sc-if>\n\n    <!-- ===== ENGAGEMENTS ===== -->\n    <sc-if value=\"{{ is_eng }}\" hint-placeholder-val=\"{{ false }}\">\n      <section data-rise=\"1\" style=\"display:grid;gap:28px;padding-bottom:clamp(64px,8cqw,112px)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap\">\n          <h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em\">Compare the three.</h2>\n          <div role=\"tablist\" aria-label=\"Choose an engagement\" sc-camel-on-key-down=\"{{ tierKeys }}\" style=\"display:inline-flex;gap:4px;padding:4px;border-radius:999px;background:#E7EBE6\">\n            <sc-for list=\"{{ tierTabs }}\" as=\"tb\" hint-placeholder-count=\"3\">\n              <button type=\"button\" role=\"tab\" id=\"{{ tb.id }}\" aria-controls=\"tier-panel\" sc-camel-tab-index=\"{{ tb.tab }}\" aria-selected=\"{{ tb.sel }}\" sc-camel-on-click=\"{{ tb.onClick }}\" style-active=\"transform:scale(0.96)\" style=\"min-height:44px;padding:0 20px;border-radius:999px;border:none;background:{{ tb.bg }};color:{{ tb.fg }};font:inherit;font-weight:600;font-size:15px;cursor:pointer;transition:background 240ms cubic-bezier(0.2,0,0,1),color 240ms cubic-bezier(0.2,0,0,1)\">{{ tb.name }}</button>\n            </sc-for>\n          </div>\n        </div>\n        <div id=\"tier-panel\" role=\"tabpanel\" aria-labelledby=\"{{ tierTabId }}\" sc-camel-tab-index=\"0\" style=\"overflow-x:auto;scrollbar-width:thin;margin:0 calc(-1 * clamp(20px,5cqw,64px));padding:0 clamp(20px,5cqw,64px);outline-offset:-4px\">\n          <div style=\"min-width:780px;display:grid;grid-template-columns:170px repeat(3,minmax(0,1fr))\">\n            <div></div>\n            <sc-for list=\"{{ tierCols }}\" as=\"c\" hint-placeholder-count=\"3\">\n              <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-tab-index=\"-1\" aria-label=\"{{ c.aria }}\" sc-camel-on-click=\"{{ c.onClick }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;cursor:pointer;position:relative;overflow:hidden;border-radius:20px 20px 0 0;background:{{ c.bg }};color:{{ c.fg }};padding:24px 22px 28px;display:grid;gap:14px;min-height:220px;align-content:end;transition:background 400ms cubic-bezier(0.2,0,0,1),color 400ms cubic-bezier(0.2,0,0,1)\">\n                <span style=\"position:absolute;inset:0;background:{{ c.glow }};pointer-events:none;transition:opacity 400ms\"></span>\n                <span style=\"position:relative;justify-self:start;display:inline-flex;align-items:center;min-height:28px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:600;background:{{ c.chipBg }};border:1px solid {{ c.chipBd }}\">{{ c.tag }}</span>\n                <span style=\"position:relative;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(44px,4.6cqw,64px);line-height:0.9;letter-spacing:-0.03em\">{{ c.name }}</span>\n              </button>\n            </sc-for>\n            <sc-for list=\"{{ tierRows }}\" as=\"r\" hint-placeholder-count=\"6\">\n              <div style=\"padding:18px 16px 18px 0;border-top:1px solid #D0D8D2;font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#5E6967;font-size:11px\">{{ r.label }}</div>\n              <sc-for list=\"{{ r.cells }}\" as=\"c\" hint-placeholder-count=\"3\">\n                <div style=\"padding:18px 22px;border-top:1px solid {{ c.line }};background:{{ c.bg }};color:{{ c.fg }};font-size:16px;line-height:1.5;border-radius:{{ c.radius }};transition:background 400ms cubic-bezier(0.2,0,0,1),color 400ms cubic-bezier(0.2,0,0,1)\">{{ c.text }}</div>\n              </sc-for>\n            </sc-for>\n          </div>\n        </div>\n        <div style=\"display:flex;gap:12px 20px;flex-wrap:wrap;align-items:center\">\n          <button type=\"button\" sc-camel-on-click=\"{{ tierCtaGo }}\" style-active=\"transform:scale(0.97)\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:inline-flex;align-items:center;min-height:52px;padding:0 22px;border-radius:999px;background:#B5532C;color:#FFFFFF;font-weight:600;font-size:15px;cursor:pointer;transition:background 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#9A4524\">{{ tierCta }}</button>\n          <span style=\"font-size:14px;color:#434F4F\">Not sure which fits? Most clients start with a Review.</span>\n        </div>\n      </section>\n      <section style=\"margin:0 calc(-1 * clamp(20px,5cqw,64px));display:flex;flex-wrap:wrap\">\n        <div style=\"flex:1 1 420px;position:relative;background:#E7EBE6;min-height:420px\"><div style=\"position:absolute;inset:0\"><image-slot id=\"eng-residency\" shape=\"rect\" placeholder=\"05 · Residency: a HUMMIN professional at a client desk\" src=\"2d5dffbc-fe2b-478b-b7e8-feef856eac25\"></image-slot></div></div>\n        <div style=\"flex:1 1 420px;background:#1E272A;color:#F4F5F1;padding:clamp(40px,6cqw,80px);display:grid;gap:20px;align-content:center\">\n          <span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#E58A5F\">About Residency</span>\n          <p style=\"margin:0;font-family:'Newsreader',serif;font-size:clamp(28px,3cqw,40px);line-height:1.12\">Inside your team. Employed by HUMMIN.</p>\n          <p style=\"margin:0;font-size:17px;line-height:1.65;color:#D0D8D2\">Resident professionals stay HUMMIN employees. We manage and support them. Their role, hours, access to information, and who they report to are agreed in writing before they start. Final decisions stay with you.</p>\n        </div>\n      </section>\n    </sc-if>\n\n    <!-- ===== WHO ===== -->\n    <sc-if value=\"{{ is_who }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;flex-wrap:wrap;gap:40px clamp(40px,6cqw,96px);align-items:start;padding-bottom:clamp(64px,8cqw,112px)\">\n        <figure style=\"margin:0;flex:1 1 320px;display:grid;gap:12px\">\n          <div style=\"position:relative;aspect-ratio:4/5\"><div style=\"position:absolute;inset:0\"><image-slot id=\"who-owner\" shape=\"rounded\" radius=\"20\" placeholder=\"07 · Owner portrait in their place of business\" src=\"e943bc6c-8fbf-45a5-bb17-de132f6f7e9c\"></image-slot></div></div>\n        </figure>\n        <div style=\"flex:1 1 420px;display:grid;gap:28px\">\n          <p style=\"margin:0;font-family:'Newsreader',serif;font-size:clamp(28px,3.2cqw,44px);line-height:1.22;letter-spacing:-0.01em\">We work best with businesses where <span style=\"color:#B5532C\">decisions sit with the owners</span>, the business is <span style=\"color:#B5532C\">already established</span>, and the owners <span style=\"color:#B5532C\">want more from it</span> than the current team has time or skills to deliver.</p>\n          <p style=\"margin:0;font-size:17px;line-height:1.65;color:#434F4F;max-width:52ch\">It also helps if you are ready to share information and take part in the change. The work goes faster when the people closest to it are involved.</p>\n          <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_assess }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;justify-self:start;display:inline-flex;align-items:center;min-height:52px;padding:0 22px;border-radius:999px;background:#1E272A;color:#F4F5F1;font-weight:600;font-size:15px;cursor:pointer\" style-hover=\"background:#434F4F\">Take the Assessment</button>\n        </div>\n      </div>\n    </sc-if>\n\n    <!-- ===== ABOUT ===== -->\n    <sc-if value=\"{{ is_about }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"display:grid;gap:28px;padding-bottom:clamp(64px,8cqw,112px)\">\n        <div style=\"display:grid;gap:14px\"><span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#B5532C\">What we hold to</span><h2 style=\"margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(32px,4cqw,54px);line-height:1.05;letter-spacing:-0.015em;max-width:20ch\">Six principles for how we work.</h2></div>\n        <div role=\"tablist\" aria-label=\"Our values\" sc-camel-on-key-down=\"{{ valKeys }}\" style=\"display:flex;flex-wrap:wrap;gap:8px\">\n          <sc-for list=\"{{ valueTabs }}\" as=\"vt\" hint-placeholder-count=\"6\">\n            <button type=\"button\" role=\"tab\" id=\"{{ vt.id }}\" aria-controls=\"val-panel\" sc-camel-tab-index=\"{{ vt.tab }}\" aria-selected=\"{{ vt.sel }}\" sc-camel-on-click=\"{{ vt.onClick }}\" style-active=\"transform:scale(0.96)\" style=\"min-height:44px;padding:0 18px;border-radius:999px;border:1px solid {{ vt.bd }};background:{{ vt.bg }};color:{{ vt.fg }};font:inherit;font-weight:600;font-size:14px;cursor:pointer;transition:background 240ms cubic-bezier(0.2,0,0,1),color 240ms cubic-bezier(0.2,0,0,1)\">{{ vt.short }}</button>\n          </sc-for>\n        </div>\n        <div id=\"val-panel\" role=\"tabpanel\" aria-labelledby=\"{{ valTabId }}\" key=\"{{ val.t }}\" style=\"display:flex;flex-wrap:wrap;gap:16px;align-items:stretch;animation:hmFade 360ms cubic-bezier(0.2,0,0,1)\">\n          <div style=\"flex:2 1 420px;display:grid;gap:16px;align-content:space-between;padding:clamp(24px,3cqw,40px) 0;border-top:2px solid #1E272A;min-height:280px\">\n            <span style=\"font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#5E6967;font-size:11px\">What we do</span>\n            <div style=\"display:grid;gap:14px\"><span style=\"font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,4cqw,56px);line-height:1.02;letter-spacing:-0.02em\">{{ val.t }}</span><span style=\"font-size:18px;line-height:1.55;color:#434F4F;max-width:40ch\">{{ val.b }}</span></div>\n          </div>\n          <div style=\"flex:1 1 260px;display:grid;gap:12px;align-content:space-between;padding:clamp(24px,3cqw,40px) 0 clamp(24px,3cqw,40px) clamp(20px,2.4cqw,32px);border-top:1px solid #BAC4BE;border-left:1px solid #D0D8D2\">\n            <span style=\"font-weight:600;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#5E6967\">What we avoid</span>\n            <span style=\"font-size:17px;line-height:1.55;color:#434F4F;max-width:32ch\">{{ val.not }}</span>\n            <span style=\"font-size:13px;color:#5E6967;font-variant-numeric:tabular-nums\">{{ val.pos }}</span>\n          </div>\n        </div>\n      </section>\n      <section style=\"display:flex;flex-wrap:wrap;gap:16px 40px;align-items:center;justify-content:space-between;padding:20px 0;margin-bottom:clamp(64px,8cqw,112px);border-top:1px solid #D0D8D2;border-bottom:1px solid #D0D8D2\">\n        <div style=\"display:flex;align-items:center;gap:16px;min-width:0\">\n          <div style=\"flex:0 0 72px;width:72px;height:72px;position:relative\"><image-slot id=\"about-muiruri\" shape=\"circle\" placeholder=\"09\" style=\"width:72px;height:72px\" src=\"5f3ebfe3-741c-4f64-8dad-084f0805e0fa\"></image-slot></div>\n          <div style=\"display:grid;gap:2px;min-width:0\">\n            <span style=\"font-family:'Newsreader',serif;font-size:24px;line-height:1.15\">Muiruri Beautah</span>\n            <span style=\"font-size:14px;color:#434F4F\">Founder and Managing Director</span>\n          </div>\n        </div>\n        <p style=\"margin:0;flex:1 1 320px;max-width:52ch;font-size:15px;line-height:1.6;color:#434F4F\">Muiruri founded HUMMIN to give owners of established businesses a partner that understands the whole business and helps carry out the work.</p>\n      </section>\n      <section style=\"margin:0 calc(-1 * clamp(20px,5cqw,64px));background:#F4F5F1;border-top:1px solid #D0D8D2;padding:clamp(64px,8cqw,112px) clamp(20px,5cqw,64px);display:flex;flex-wrap:wrap;gap:40px clamp(40px,6cqw,96px);align-items:center\">\n        <div data-rise=\"1\" style=\"flex:2 1 460px;display:grid;gap:20px\">\n          <div style=\"display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 20px\">\n            <span style=\"font-family:'Newsreader',serif;font-weight:400;font-size:clamp(64px,9cqw,132px);line-height:0.9;letter-spacing:-0.03em\">hum·min</span>\n            <span style=\"font-size:clamp(20px,2cqw,26px);color:#434F4F\">/ˈhʌm.ɪn/</span>\n          </div>\n          <div style=\"display:grid;gap:18px;border-top:1px solid #1E272A;padding-top:22px;max-width:60ch\">\n            <p style=\"margin:0;font-size:clamp(18px,1.7cqw,21px);line-height:1.55\"><span style=\"font-weight:700\">1</span>&nbsp; <em style=\"font-family:'Newsreader',serif;font-weight:400;font-size:1.08em;color:#5E6967\">noun</em>&nbsp; An embedded advisory and execution partner for owner-led businesses.</p>\n            <p style=\"margin:0;font-size:clamp(18px,1.7cqw,21px);line-height:1.55\"><span style=\"font-weight:700\">2</span>&nbsp; <em style=\"font-family:'Newsreader',serif;font-weight:400;font-size:1.08em;color:#5E6967\">verb, informal</em>&nbsp; To work steadily and well in the background.</p>\n          </div>\n        </div>\n        <img src=\"69600b5c-99d3-4ec0-9520-3db39d09fc81\" alt=\"\" style=\"flex:1 1 240px;max-width:360px;width:100%\">\n      </section>\n        </sc-if>\n\n    <!-- ===== CONTACT ===== -->\n    <sc-if value=\"{{ is_contact }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;flex-wrap:wrap;gap:40px clamp(40px,6cqw,96px);padding-bottom:clamp(64px,8cqw,112px)\">\n        <div style=\"flex:2 1 440px\">\n          <sc-if value=\"{{ not_sent }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:grid;gap:28px;max-width:620px\">\n              <sc-for list=\"{{ fields }}\" as=\"fd\" hint-placeholder-count=\"4\">\n                <label style=\"display:grid;gap:8px\">\n                  <span style=\"font-size:14px;font-weight:600\">{{ fd.label }} <span aria-hidden=\"true\" style=\"color:#B5532C\">*</span></span>\n                  <sc-if value=\"{{ fd.multi }}\" hint-placeholder-val=\"{{ false }}\"><textarea id=\"{{ fd.id }}\" name=\"{{ fd.k }}\" required=\"\" aria-invalid=\"{{ fd.inv }}\" aria-describedby=\"{{ fd.errId }}\" value=\"{{ fd.value }}\" sc-camel-on-change=\"{{ fd.onChange }}\" rows=\"4\" placeholder=\"{{ fd.ph }}\" style=\"font:inherit;font-size:18px;line-height:1.5;padding:12px 0;border:none;border-bottom:1.5px solid {{ fd.bd }};background:transparent;color:#1E272A;transition:border-color 160ms cubic-bezier(0.2,0,0,1),box-shadow 160ms cubic-bezier(0.2,0,0,1);resize:vertical;outline:none;border-radius:0\" style-focus=\"border-bottom-color:#1E272A;box-shadow:0 1.5px 0 #1E272A;outline:none\"></textarea></sc-if>\n                  <sc-if value=\"{{ fd.single }}\" hint-placeholder-val=\"{{ true }}\"><input id=\"{{ fd.id }}\" name=\"{{ fd.k }}\" sc-camel-auto-complete=\"{{ fd.ac }}\" required=\"\" aria-invalid=\"{{ fd.inv }}\" aria-describedby=\"{{ fd.errId }}\" type=\"{{ fd.type }}\" value=\"{{ fd.value }}\" sc-camel-on-change=\"{{ fd.onChange }}\" placeholder=\"{{ fd.ph }}\" style=\"font:inherit;font-size:18px;min-height:52px;padding:0;border:none;border-bottom:1.5px solid {{ fd.bd }};background:transparent;color:#1E272A;transition:border-color 160ms cubic-bezier(0.2,0,0,1),box-shadow 160ms cubic-bezier(0.2,0,0,1);outline:none;border-radius:0\" style-focus=\"border-bottom-color:#1E272A;box-shadow:0 1.5px 0 #1E272A;outline:none\"></sc-if>\n                  <span id=\"{{ fd.errId }}\" role=\"alert\" style=\"font-size:14px;color:#B5532C\">{{ fd.err }}</span>\n                </label>\n              </sc-for>\n              <div style=\"display:flex;gap:16px;align-items:center;flex-wrap:wrap\"><button type=\"button\" sc-camel-on-click=\"{{ submit }}\" aria-disabled=\"{{ sendingStr }}\" style-active=\"transform:scale(0.97)\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;border:none;background:#B5532C;color:#FFFFFF;font:inherit;font-weight:600;font-size:15px;cursor:pointer;opacity:{{ sendOp }};transition:background 160ms cubic-bezier(0.2,0,0,1),opacity 160ms\" style-hover=\"background:#9A4524\"><sc-if value=\"{{ sending }}\" hint-placeholder-val=\"{{ false }}\"><span aria-hidden=\"true\" style=\"display:block;width:16px;height:16px;border-radius:999px;border:2px solid rgba(255,255,255,0.35);border-top-color:#FFFFFF;animation:hmSpin 700ms linear infinite\"></span></sc-if>{{ sendLabel }}</button><span style=\"font-size:13px;color:#5E6967\">All fields are required.</span></div>\n            </div>\n          </sc-if>\n          <sc-if value=\"{{ sent }}\" hint-placeholder-val=\"{{ false }}\">\n            <div role=\"status\" style=\"display:grid;gap:16px;max-width:520px;animation:hmFade 420ms cubic-bezier(0.2,0,0,1)\">\n              <span aria-hidden=\"true\" style=\"display:grid;place-items:center;width:52px;height:52px;border-radius:999px;background:#DCEBE5;color:#2E6B5C;font-size:24px;animation:hmPop 420ms cubic-bezier(0.2,0,0,1)\">✓</span>\n              <span ref=\"{{ sentRef }}\" sc-camel-tab-index=\"-1\" style=\"outline:none;font-family:'Newsreader',serif;font-size:clamp(32px,3.6cqw,48px);line-height:1.05\">Thanks for reaching out.</span>\n              <p style=\"margin:0;font-size:17px;line-height:1.65;color:#434F4F\">We’ll review your note and get back to you using the details you shared.</p>\n              <button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ reset }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;justify-self:start;font-weight:600;font-size:15px;color:#B5532C;cursor:pointer;border-bottom:1px solid #B5532C\">Send Another Enquiry</button>\n            </div>\n          </sc-if>\n        </div>\n        <div style=\"flex:1 1 260px;display:grid;gap:20px;align-content:start\">\n          <div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap\"><a href=\"mailto:sales@hummin.org\" style=\"display:flex;align-items:center;gap:12px;font-family:'Newsreader',serif;font-size:28px;color:#1E272A\"><img src=\"34508a24-b2f6-475b-9efe-357ea43a219f\" alt=\"\" aria-hidden=\"true\" style=\"width:22px;height:22px\">sales@hummin.org</a><button type=\"button\" sc-camel-on-click=\"{{ copyEmail }}\" aria-label=\"Copy email address\" style-active=\"transform:scale(0.95)\" style=\"min-height:36px;padding:0 14px;border-radius:999px;border:1px solid #BAC4BE;background:{{ copyBg }};color:#1E272A;font:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:background 160ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#E7EBE6\">{{ copyLabel }}</button><span role=\"status\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)\">{{ copyStatus }}</span></div>\n          <span style=\"display:flex;align-items:center;gap:12px;font-size:17px\"><img src=\"f46ed469-83d7-4d18-9b79-350a047b9f00\" alt=\"\" style=\"width:20px;height:20px\">Nairobi, Kenya</span>\n          <p style=\"margin:0;font-size:15px;line-height:1.6;color:#434F4F\">We review your note. If we can help, we’ll suggest a first conversation.</p>\n        </div>\n      </div>\n    </sc-if>\n  </main>\n\n  <sc-if value=\"{{ is_assess }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"margin-top:calc(-1 * clamp(48px,7cqw,104px))\">\n      <dc-import name=\"HUMMIN Assessment v2\" on-contact=\"{{ go_contact }}\" hint-size=\"100%,900px\"></dc-import>\n    </div>\n  </sc-if>\n  <sc-if value=\"{{ is_insights }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"margin-top:calc(-1 * clamp(48px,7cqw,104px))\">\n      <dc-import name=\"HUMMIN Insights\" on-contact=\"{{ go_contact }}\" on-assess=\"{{ go_assess }}\" on-nav=\"{{ goPage }}\" open-post=\"{{ insightPost }}\" open-nonce=\"{{ insightNonce }}\" hint-size=\"100%,1200px\"></dc-import>\n    </div>\n  </sc-if>\n  </div>\n\n  <sc-if value=\"{{ show_float }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:sticky;bottom:16px;z-index:15;display:flex;justify-content:center;padding:0 16px;pointer-events:none;margin-top:-72px;height:72px;align-items:end\">\n      <div role=\"complementary\" aria-label=\"Assessment\" style=\"pointer-events:auto;animation:hmRise 480ms cubic-bezier(0.2,0,0,1);display:flex;align-items:center;gap:14px;padding:8px 8px 8px 20px;border-radius:999px;background:rgba(30,39,42,0.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:#F4F5F1;box-shadow:0 12px 32px rgba(30,39,42,0.25);max-width:100%\">\n        <span style=\"font-size:14px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">What is holding the business back? <span style=\"color:#BAC4BE\">8 minutes</span></span>\n        <button type=\"button\" style-active=\"transform:scale(0.97)\" aria-label=\"Start the assessment\" sc-camel-on-click=\"{{ go_assess }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;flex-shrink:0;display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;background:#B5532C;color:#FFFFFF;font-weight:600;font-size:14px;cursor:pointer\" style-hover=\"background:#9A4524\">Start</button>\n        <button type=\"button\" sc-camel-on-click=\"{{ dismissFloat }}\" aria-label=\"Dismiss the assessment prompt\" style-active=\"transform:scale(0.92)\" style=\"flex-shrink:0;width:36px;height:36px;border-radius:999px;border:none;background:rgba(244,245,241,0.1);cursor:pointer;display:grid;place-items:center\"><img src=\"8ecfd409-111e-4eb2-8a8f-aaf10af4e998\" alt=\"\" style=\"width:14px\"></button>\n      </div>\n    </div>\n  </sc-if>\n\n  <!-- ASSESSMENT BAND -->\n  <sc-if value=\"{{ show_band }}\" hint-placeholder-val=\"{{ true }}\">\n    <section aria-label=\"Assessment\" style=\"background:#B5532C;color:#FFFFFF\">\n      <div style=\"margin:0 auto;padding:clamp(56px,7cqw,96px) clamp(20px,5cqw,64px);display:flex;flex-wrap:wrap;gap:28px 64px;align-items:end;justify-content:space-between\">\n        <div style=\"flex:1 1 420px;display:grid;gap:16px\">\n          <span style=\"font-family:'Newsreader',serif;font-size:clamp(32px,4cqw,56px);line-height:1.04;letter-spacing:-0.015em;max-width:18ch\">Find out what is holding your business back.</span>\n          <span style=\"font-size:17px;line-height:1.55;max-width:46ch\">Answer 23 short questions. See where the gaps are, what they may be costing you, and what to fix first.</span>\n        </div>\n        <div style=\"display:grid;gap:10px;justify-items:start\"><button type=\"button\" style-active=\"transform:scale(0.97)\" sc-camel-on-click=\"{{ go_assess }}\" style=\"font:inherit;color:inherit;border:none;background:none;padding:0;margin:0;text-align:inherit;display:inline-flex;align-items:center;min-height:52px;padding:0 22px;border-radius:999px;background:#1E272A;color:#F4F5F1;font-weight:600;font-size:15px;cursor:pointer\" style-hover=\"background:#2A3538\">Take the Assessment</button><span style=\"font-size:14px\">About 8 minutes · No cost</span></div>\n      </div>\n    </section>\n  </sc-if>\n\n  <div aria-hidden=\"{{ peekHidden }}\" style=\"position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:16px;visibility:{{ peekVis }};pointer-events:{{ peekEvents }}\">\n    <div sc-camel-on-click=\"{{ closePeek }}\" style=\"position:absolute;inset:0;background:rgba(30,39,42,0.5);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);opacity:{{ peekOp }};transition:opacity 240ms cubic-bezier(0.2,0,0,1)\"></div>\n    <div role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"peek-title\" sc-camel-on-key-down=\"{{ peekKeys }}\" style=\"position:relative;width:min(560px,100%);max-height:calc(100vh - 32px);overflow-y:auto;border-radius:24px;background:#F4F5F1;color:#1E272A;box-shadow:0 32px 80px rgba(30,39,42,0.35);opacity:{{ peekOp }};transform:{{ peekTf }};transition:opacity 240ms cubic-bezier(0.2,0,0,1),transform 320ms cubic-bezier(0.2,0,0,1)\">\n      <div style=\"position:relative;overflow:hidden;background:{{ pk.bg }};color:{{ pk.fg }};padding:24px 24px 28px;display:grid;gap:18px\">\n        <span style=\"position:absolute;inset:0;background:{{ pk.glow }};pointer-events:none\"></span>\n        <div style=\"position:relative;display:flex;justify-content:space-between;align-items:start;gap:16px\">\n          <span style=\"display:inline-flex;align-items:center;min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:600;background:{{ pk.chipBg }};border:1px solid {{ pk.chipBd }}\">{{ pk.chip }}</span>\n          <button type=\"button\" ref=\"{{ peekCloseRef }}\" sc-camel-on-click=\"{{ closePeek }}\" aria-label=\"Close\" style-active=\"transform:scale(0.92)\" style=\"flex-shrink:0;width:40px;height:40px;border-radius:999px;border:1px solid {{ pk.chipBd }};background:{{ pk.chipBg }};color:inherit;font:inherit;font-size:18px;line-height:1;cursor:pointer;display:grid;place-items:center;transition:transform 160ms cubic-bezier(0.2,0,0,1)\" style-hover=\"transform:rotate(90deg)\"><span aria-hidden=\"true\">×</span></button>\n        </div>\n        <h2 id=\"peek-title\" style=\"position:relative;margin:0;font-family:'Newsreader',serif;font-weight:400;font-size:clamp(34px,5cqw,48px);line-height:1;letter-spacing:-0.02em\">{{ pk.title }}</h2>\n        <p style=\"position:relative;margin:0;font-size:17px;line-height:1.55\">{{ pk.lead }}</p>\n      </div>\n      <dl style=\"margin:0;padding:8px 24px 0;display:grid\">\n        <sc-for list=\"{{ pk.rows }}\" as=\"r\" hint-placeholder-count=\"3\">\n          <div style=\"display:grid;gap:4px;padding:16px 0;border-bottom:1px solid #D0D8D2\">\n            <dt style=\"font-weight:600;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#5E6967\">{{ r.label }}</dt>\n            <dd style=\"margin:0;font-size:16px;line-height:1.55\">{{ r.text }}</dd>\n          </div>\n        </sc-for>\n      </dl>\n      <div style=\"padding:20px 24px 24px;display:flex;flex-wrap:wrap;gap:10px\">\n        <button type=\"button\" sc-camel-on-click=\"{{ pk.primary }}\" style-active=\"transform:scale(0.97)\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border-radius:999px;border:none;background:#B5532C;color:#FFFFFF;font:inherit;font-weight:600;font-size:15px;cursor:pointer;transition:background 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#9A4524\">{{ pk.primaryLabel }} <span aria-hidden=\"true\">→</span></button>\n        <button type=\"button\" sc-camel-on-click=\"{{ pk.secondary }}\" style-active=\"transform:scale(0.97)\" style=\"display:inline-flex;align-items:center;min-height:48px;padding:0 20px;border-radius:999px;border:1px solid #1E272A;background:transparent;color:#1E272A;font:inherit;font-weight:600;font-size:15px;cursor:pointer;transition:background 120ms cubic-bezier(0.2,0,0,1)\" style-hover=\"background:#E7EBE6\">{{ pk.secondaryLabel }}</button>\n      </div>\n    </div>\n  </div>\n\n  <footer style=\"background:#1E272A;color:#BAC4BE\">\n    <div style=\"margin:0 auto;padding:40px clamp(20px,5cqw,64px);display:flex;flex-wrap:wrap;gap:20px 40px;justify-content:space-between;align-items:center;font-size:14px\">\n      <div style=\"display:flex;align-items:center;gap:12px\"><img src=\"9381c5d9-b1fa-4f32-ab5d-4815b4e79974\" alt=\"\" aria-hidden=\"true\" style=\"width:44px\"><span style=\"font-weight:600;letter-spacing:0.18em;color:#F4F5F1\">HUMMIN</span></div>\n      <span>Embedded advisory and execution · Nairobi, Kenya</span>\n      <a href=\"mailto:sales@hummin.org\" style=\"color:#F4F5F1\">sales@hummin.org</a>\n      <span>© 2026 HUMMIN</span>\n    </div>\n  </footer>\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nconst IC = n => (window.__resources && window.__resources['ic_' + n]) || 'https://unpkg.com/lucide-static@0.460.0/icons/' + n + '.svg';\nconst PAPER = n => (window.__resources && window.__resources['pp_' + n]) || 'assets/icons/' + n + '.svg';\nconst PAGES = [\n  ['home', 'Home', 'house'], ['how', 'How We Work', 'route'], ['core', 'Applied Expertise', 'layers'], ['eng', 'Engagements', 'handshake'],\n  ['who', 'Who We Work With', 'users'], ['assess', 'Assessment', 'clipboard-check'], ['about', 'About', 'building-2'], ['insights', 'Insights', 'newspaper'], ['contact', 'Contact', 'mail']\n];\nconst HEADS = {\n  how: { label: 'How We Work', icon: IC('route'), iconPaper: PAPER('route'), title: 'Understand the problem. Then fix it.', lead: 'We begin by understanding the business. Then we agree what needs to change, who will do the work, and how progress will be measured.' },\n  core: { label: 'Applied Expertise', icon: IC('layers'), iconPaper: PAPER('layers'), title: 'The skills we bring to the work.', lead: 'Most business problems touch more than one area. We bring in the skills each problem needs and manage them as one team, so you deal with one point of contact.' },\n  eng: { label: 'Engagements', icon: IC('handshake'), iconPaper: PAPER('handshake'), title: 'Review. Project. Residency.', lead: 'Three ways to work with us. Each one stands alone, and many clients start with a Review.' },\n  who: { label: 'Who We Work With', icon: IC('users'), iconPaper: PAPER('users'), title: 'You know your business.', lead: 'We bring another set of eyes and the people needed to act. We work with established, owner-led businesses that want to grow but are short of time or skills.' },\n  about: { label: 'About', icon: IC('building-2'), iconPaper: PAPER('building-2'), title: 'About HUMMIN.', lead: 'Businesses rarely encounter problems in neat categories. We work alongside owners to understand what is happening, bring in the right expertise, and stay involved in the work.' },\n  contact: { label: 'Contact', icon: IC('mail'), iconPaper: PAPER('mail'), title: 'Discuss a business challenge.', lead: 'Tell us what you would like to work on. You don’t need to know which discipline it falls under.' }\n};\nconst HERO_STYLE = {\n  how: { bg: 'radial-gradient(circle at 70% 20%,#5E6967 0%,#2A3538 40%,#1E272A 72%)', glow: 'radial-gradient(circle at 12% 95%,rgba(30,39,42,0.6),transparent 45%)', chip: 'Four steps', img: 'Image: reviewing a process with the people who run it.' },\n  core: { bg: 'radial-gradient(circle at 30% 15%,#5E6967 0%,#2A3538 42%,#1E272A 75%)', glow: 'radial-gradient(circle at 90% 90%,rgba(30,39,42,0.6),transparent 45%)', chip: 'Seven areas', img: 'Image: a working session with specialists.' },\n  eng: { bg: 'radial-gradient(circle at 80% 30%,#434F4F 0%,#2A3538 40%,#1E272A 72%)', glow: 'radial-gradient(circle at 20% 90%,rgba(30,39,42,0.6),transparent 48%)', chip: 'Review · Project · Residency', img: 'Image: a HUMMIN professional on site.' },\n  who: { bg: 'radial-gradient(circle at 65% 25%,#5E6967 0%,#2A3538 42%,#1E272A 74%)', glow: 'radial-gradient(circle at 10% 90%,rgba(30,39,42,0.6),transparent 45%)', chip: 'Owner-led businesses', img: 'Image: an owner in their place of business.' },\n  about: { bg: 'radial-gradient(circle at 75% 20%,#5E6967 0%,#2A3538 40%,#1E272A 72%)', glow: 'radial-gradient(circle at 15% 95%,rgba(30,39,42,0.6),transparent 45%)', chip: 'Nairobi, Kenya', img: 'Image: the HUMMIN team at work.' },\n  contact: { bg: 'radial-gradient(circle at 70% 30%,#434F4F 0%,#2A3538 40%,#1E272A 72%)', glow: 'radial-gradient(circle at 85% 95%,rgba(30,39,42,0.6),transparent 45%)', chip: 'sales@hummin.org', img: '' }\n};\nconst STAGES = [\n  { name: 'Understand', short: 'We find the cause behind the symptom.', what: 'We talk to you and your team, look at how the work gets done, and review the numbers. We look for the cause behind the symptom.', out: 'a clear statement of the problem and what it costs the business.' },\n  { name: 'Architect', short: 'We agree the plan, the people, and the cost.', what: 'We agree what needs to change, who will do it, what it will cost, and how we will measure it.', out: 'a plan with roles, costs, and measures.' },\n  { name: 'Execute', short: 'We do the work with your team.', what: 'We do the work alongside your team and report progress to the person who makes decisions.', out: 'the agreed work, done and measured.' },\n  { name: 'Institutionalise', short: 'We write it down and hand it over.', what: 'We write down the new way of working, train the people who will run it, and hand it over.', out: 'written processes, trained staff, and measures you can keep using.' }\n];\nconst DOMAINS = [\n  { name: 'Strategy', icon: 'compass', lead: 'Decide which problems to solve first, and why.', jobs: 'We review how the business makes money and where it loses it, set clear priorities for the next 12 months, and turn the plan into a schedule of work with named owners.' },\n  { name: 'Technology', icon: 'monitor-smartphone', lead: 'Make your systems fit the way the business works.', jobs: 'We build or fix websites, set up CRMs so every enquiry is recorded, and automate repeated admin tasks.' },\n  { name: 'Marketing', icon: 'megaphone', lead: 'Bring in the right customers, and keep track of them.', jobs: 'We clarify who you sell to and what you say, plan and run advertising, and check what happens to each enquiry after it arrives.' },\n  { name: 'Operations', icon: 'workflow', lead: 'Make everyday work run smoothly.', jobs: 'We map how work moves through the business, remove the steps that slow it down, and set up simple reports on how it is going.' },\n  { name: 'Talent', icon: 'user-round-check', lead: 'Put the right people in the right roles.', jobs: 'We write clear roles and responsibilities, help recruit for key positions, and train staff on new processes and tools.' },\n  { name: 'Data', icon: 'chart-column', lead: 'Base decisions on records you can trust.', jobs: 'We choose the figures worth tracking, build simple monthly dashboards, and measure whether a change worked.' },\n  { name: 'Specialist Partners', icon: 'briefcase', lead: 'Bring in qualified experts when the work needs them.', jobs: 'Accountants, financial advisers, lawyers, HR professionals, software engineers, and recruiters, managed by HUMMIN under one agreement.', ext: true }\n];\nconst ENGS = [\n  { tag: 'Short engagement', icon: 'search', name: 'Review', body: 'We investigate a problem and give you a clear plan to fix it.', itemsText: 'You get a review of the area that is not working, our findings in order of priority, and a practical plan with costs and measures.', comm: 'a fixed fee for an agreed scope.' },\n  { tag: 'Defined work', icon: 'hammer', name: 'Project', body: 'We design and deliver a defined piece of work.', itemsText: 'You get agreed deliverables and milestones, a clear definition of done, any specialist partners managed by us, and regular progress reports.', comm: 'paid at milestones. Any extra costs are agreed in advance.' },\n  { tag: 'Ongoing', icon: 'door-open', name: 'Residency', body: 'A HUMMIN professional works inside your team, with support from Applied Expertise.', itemsText: 'They coordinate the agreed work day to day, bring in HUMMIN specialists when needed, and are managed by HUMMIN. Their role and reporting lines are set in the contract.', comm: 'a monthly fee based on scope and the people involved.' }\n];\nconst TOPICS = [\n  { title: 'Enquiries that go unanswered.', area: 'Marketing · Operations', lead: 'Enquiries arrive, but no one owns the follow-up. Some never get a reply.', look: 'How enquiries arrive, who answers them, how quickly, and what gets recorded.', start: 'A Review. It shows where enquiries are lost and what to fix first.' },\n  { title: 'A website that loses visitors.', area: 'Technology', lead: 'People visit the site but do not call, write, or buy.', look: 'What visitors look for, where they leave, and how the site asks them to get in touch.', start: 'A Review, then a Project to rebuild the pages that matter.' },\n  { title: 'Systems the team does not use.', area: 'Technology · Talent', lead: 'The business paid for tools, but the team works around them.', look: 'How the work is done today, where the tools get in the way, and what training is missing.', start: 'A Review. Often followed by a Project to set the tools up properly.' },\n  { title: 'Too much still runs through the owner.', area: 'Strategy · Operations', lead: 'Decisions and approvals wait for one person, so work slows down.', look: 'Which decisions can be handed over, to whom, and within what limits.', start: 'A Review, then a Residency to make the change stick.' },\n  { title: 'Figures that arrive too late to act on.', area: 'Data', lead: 'Reports come weeks after the month ends, when it is too late to act.', look: 'Which figures matter, where they come from, and how to get them sooner.', start: 'A Project to set up a simple monthly dashboard.' },\n  { title: 'A team stretched too thin.', area: 'Talent', lead: 'Good people are doing too many jobs, and some work is not getting done.', look: 'Who does what today, what can be removed, and which roles are missing.', start: 'A Review of roles and workload.' }\n];\nconst SCR = () => { const el = document.scrollingElement || document.documentElement; return el; };\nconst VALUES = [\n  { short: 'Understanding', t: 'Understanding before intervention.', b: 'We investigate before prescribing.', not: 'Recommend a fix before we understand the problem.' },\n  { short: 'Action', t: 'Intelligence in action.', b: 'We connect insight to implementation.', not: 'Hand over a report and walk away when the work is ours to do.' },\n  { short: 'Independence', t: 'Proximity with independence.', b: 'We work closely with clients without surrendering professional judgement.', not: 'Tell you what you want to hear.' },\n  { short: 'Discipline', t: 'Adaptability with discipline.', b: 'We tailor solutions without compromising quality or accountability.', not: 'Sell every client the same solution.' },\n  { short: 'Responsibility', t: 'Partnership with responsibility.', b: 'We treat trust as an obligation and agreed outcomes as a shared priority.', not: 'Share your information without your permission.' },\n  { short: 'Capability', t: 'Capability beyond dependency.', b: 'We build systems and people that become stronger through our involvement.', not: 'Make the business depend on us.' }\n];\nconst NEEDS = [\n  { icon: PAPER('user-round-check'), v: 'A decision-maker', k: 'One person who can approve changes.' },\n  { icon: PAPER('key-round'), v: 'Access', k: 'To the information and systems the work depends on.' },\n  { icon: PAPER('clock'), v: 'Time', k: 'With the people who do the work every day.' },\n  { icon: PAPER('target'), v: 'A measure', k: 'Agreed at the start, so we both know what a good result looks like.' }\n];\nconst TIERS = [\n  { name: 'Review', tag: 'Short engagement', best: 'You know something is wrong, but not exactly what.', what: 'We investigate the problem and set out a clear plan to fix it.', get: 'Findings in order of priority, and a practical plan with costs and measures.', ends: 'When the plan is delivered to you.', role: 'Share information and give us time with your team.', fees: 'A fixed fee for an agreed scope.' },\n  { name: 'Project', tag: 'Defined work', best: 'You know what needs to change and need it done.', what: 'We design and deliver a defined piece of work, managing any specialists involved.', get: 'Agreed deliverables, milestones, and regular progress reports.', ends: 'When the agreed work meets its definition of done.', role: 'Approve the plan and make decisions on time.', fees: 'Paid at milestones. Extra costs are agreed in advance.' },\n  { name: 'Residency', tag: 'Ongoing', best: 'You need someone close to the work, week after week.', what: 'A HUMMIN professional works inside your team, supported by our Applied Expertise.', get: 'Day-to-day coordination, and access to HUMMIN specialists when needed.', ends: 'Ongoing, reviewed on dates we agree.', role: 'Set direction and agree the role and reporting lines.', fees: 'A monthly fee based on scope and the people involved.' }\n];\nconst TIER_ROWS = [['Best when', 'best'], ['What happens', 'what'], ['You get', 'get'], ['Ends', 'ends'], ['Your part', 'role'], ['Fees', 'fees']];\nconst FIELDS = [\n  { k: 'name', label: 'Name', type: 'text', ph: 'Your full name' },\n  { k: 'biz', label: 'Business Name', type: 'text', ph: 'Registered or trading name' },\n  { k: 'email', label: 'Work Email', type: 'email', ph: 'name@business.com' },\n  { k: 'msg', label: 'What Would You Like to Work On?', type: 'text', ph: 'A few sentences about the challenge', multi: true }\n];\n\nclass Component extends DCLogic {\n  state = { peek: null, peekOpen: false, sending: false, copied: false, scrolled: false, page: 'home', menu: false, floatOff: false, core: 0, tier: 0, val: 0, f: { name: '', biz: '', email: '', msg: '' }, err: {}, sent: false };\n  root = React.createRef(); pageRef = React.createRef(); peekCloseRef = React.createRef(); sentRef = React.createRef();\n  rise() {\n    const root = this.root.current; if (!root || !window.IntersectionObserver) return;\n    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (!this.io) this.io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { const el = e.target; el.style.opacity = '1'; el.style.transform = 'none'; this.io.unobserve(el); setTimeout(() => { el.style.willChange = 'auto'; }, 900); } }), { threshold: 0, rootMargin: '0px 0px -8% 0px' });\n    root.querySelectorAll('[data-rise]').forEach(el => {\n      if (el.dataset.risen) return; el.dataset.risen = '1';\n      if (reduce) return;\n      const sibs = el.parentElement ? [...el.parentElement.children].filter(c => c.hasAttribute('data-rise')) : [];\n      const idx = Math.max(0, sibs.indexOf(el));\n      el.style.opacity = '0'; el.style.transform = 'translate3d(0,20px,0)'; el.style.willChange = 'opacity, transform';\n      el.style.transition = 'opacity 700ms cubic-bezier(0.2,0,0,1) ' + Math.min(idx, 5) * 70 + 'ms, transform 800ms cubic-bezier(0.2,0,0,1) ' + Math.min(idx, 5) * 70 + 'ms';\n      this.io.observe(el);\n    });\n  }\n  componentDidUpdate() { if (this._lastPage !== this.state.page) { this._lastPage = this.state.page; requestAnimationFrame(() => this.rise()); } }\n  scrollShelf(d, ev) { const sec = ev && ev.currentTarget && ev.currentTarget.closest('section'); const el = (sec && sec.querySelector('[data-shelf]')) || (this.root.current && this.root.current.querySelector('[data-shelf]')) || document.querySelector('[data-shelf]'); if (el) el.scrollBy({ left: d * Math.min(320, el.clientWidth * 0.8), behavior: 'smooth' }); }\n  componentDidMount() {\n    this.onKey = e => { if (e.key !== 'Escape') return; if (this.state.peekOpen) this.closePeek(); else if (this.state.menu) this.setState({ menu: false }); };\n    this.onScroll = () => { const y = window.scrollY || SCR().scrollTop; const s = y > 8; if (s !== this.state.scrolled) this.setState({ scrolled: s }); };\n    window.addEventListener('scroll', this.onScroll, { passive: true });\n    if (window.MutationObserver && this.root.current) { this.mo = new MutationObserver(() => { cancelAnimationFrame(this._moR); this._moR = requestAnimationFrame(() => this.rise()); }); this.mo.observe(this.root.current, { childList: true, subtree: true }); }\n    window.addEventListener('keydown', this.onKey);\n    this._lastPage = this.state.page;\n    requestAnimationFrame(() => this.rise());\n  }\n  componentWillUnmount() { clearTimeout(this._hoverT); clearTimeout(this._copyT); window.removeEventListener('scroll', this.onScroll); if (this.mo) this.mo.disconnect(); window.removeEventListener('keydown', this.onKey); if (this.io) this.io.disconnect(); }\n  openPeek(kind, i) { this._opener = document.activeElement; this.setState({ peek: { kind, i }, peekOpen: true }); setTimeout(() => { const b = this.peekCloseRef.current; if (b) b.focus(); }, 60); }\n  closePeek(after) { this.setState({ peekOpen: false }); const op = this._opener; setTimeout(() => { if (after) after(); else if (op && op.focus) op.focus(); }, 200); }\n  go(p, extra) {\n    if (p === this.state.page && !extra) { this.setState({ menu: false }); return; }\n    const pg = this.pageRef.current, reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (pg && !reduce) { pg.style.opacity = '0'; pg.style.transform = 'translate3d(0,8px,0)'; }\n    setTimeout(() => {\n      this._go(p, extra);\n      requestAnimationFrame(() => { if (pg) { pg.style.opacity = '1'; pg.style.transform = 'none'; } const m = document.getElementById('main'); if (m && p !== 'home') m.focus({ preventScroll: true }); });\n    }, pg && !reduce ? 180 : 0);\n  }\n  _go(p, extra) {\n    this.setState({ page: